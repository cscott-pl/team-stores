# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Environment — build-time concerns only.
# Brand/tenant identity is runtime config in src/config/, never build-time constants.
.env
.env.*
!.env.example

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / tooling caches
coverage/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Design export — reference/uploads/ is 213 MB across 562 files and is
# referenced zero times by the in-scope Workspace (workspace-app.jsx).
# Kept on disk for completeness, deliberately out of git history.
# The rest of reference/ is committed as-is and must never be edited.
reference/uploads/
